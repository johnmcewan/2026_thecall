# Co-occurrence count
tarzan_cooccur <- tarzan_words %>%
pairwise_count(word, section, sort = TRUE, upper = FALSE)
# Build graph
tarzan_cooccur_graph <- tarzan_cooccur %>%
filter(n > 5) %>%
graph_from_data_frame(directed = FALSE)
# Plot
ggraph(tarzan_cooccur_graph, layout = "fr") +
geom_edge_link(
aes(edge_alpha = n, edge_width = n),
colour = "steelblue",
show.legend = TRUE
) +
geom_node_point(size = 10, colour = "tomato") +
geom_node_text(aes(label = name), repel = TRUE, size = 4, fontface = "bold") +
scale_edge_width(range = c(0.5, 3)) +
scale_edge_alpha(range = c(0.3, 1)) +
guides(edge_alpha = guide_legend("Co-occurrences"),
edge_width  = guide_legend("Co-occurrences")) +
theme_void() +
labs(
title = "Tarzan of the Apes — Character Co-occurrence Network",
subtitle = "Edge weight = how often characters appear in the same scene"
)
