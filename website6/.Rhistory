#### assignment 6 #####
# TF_IDF - Term Frequency Inverse Document Frequency
# Step 1: Import articles 16–25
getwd()
article16 <- readtext("article16.txt")
article17 <- readtext("article17.txt")
article18 <- readtext("article18.txt")
article19 <- readtext("article19.txt")
article20 <- readtext("article20.txt")
article21 <- readtext("article21.txt")
article22 <- readtext("article22.txt")
article23 <- readtext("article23.txt")
article24 <- readtext("article24.txt")
article25 <- readtext("article25.txt")
# Step 2: Compute TF-IDF scores
# Packages
library(readtext)
library(quanteda)
library(tidyverse)
library(gridExtra)
# Create corpus
Assi6_corpus <- corpus(c(article16$text, article17$text, article18$text,
article19$text, article20$text, article21$text,
article22$text, article23$text, article24$text,
article25$text))
# Pre-processing
Assi6_token <- tokens(Assi6_corpus, remove_punct = TRUE,
remove_numbers = TRUE, remove_separators = TRUE,
remove_url = TRUE, remove_symbols = TRUE)
Assi6_token <- tokens_tolower(Assi6_token)
custom_stopwords <- c("said", "also", "new", "york", "times", "mr", "ms")
Assi6_token <- tokens_remove(Assi6_token,
pattern = c(stopwords("en"), custom_stopwords))
# Create DFM
# Create DFM
assi6_dfm <- dfm(Assi6_token)
# Compute TF-IDF
assi6_tf_idf <- dfm_tfidf(assi6_dfm, scheme_tf = "count",
scheme_df = "inverse",
base = 10,
force = FALSE)
# View top 10 TF-IDF words per article
topfeatures(assi6_tf_idf[1,], 10)  # article 16
topfeatures(assi6_tf_idf[2,], 10)  # article 17
topfeatures(assi6_tf_idf[3,], 10)  # article 18
topfeatures(assi6_tf_idf[4,], 10)  # article 19
topfeatures(assi6_tf_idf[5,], 10)  # article 20
topfeatures(assi6_tf_idf[6,], 10)  # article 21
topfeatures(assi6_tf_idf[7,], 10)  # article 22
topfeatures(assi6_tf_idf[8,], 10)  # article 23
topfeatures(assi6_tf_idf[9,], 10)  # article 24
topfeatures(assi6_tf_idf[10,], 10) # article 25
# Step 3: Visualize the features
# ── NEW: convert TF-IDF dfm to a tidy data frame ──────────────
top10_features <- convert(assi6_tf_idf, to = "data.frame") %>%
pivot_longer(cols = -doc_id, names_to = "word", values_to = "tf_idf") %>%
filter(tf_idf > 0) %>%                  # drop zero-scored words
group_by(doc_id) %>%
slice_max(tf_idf, n = 10, with_ties = FALSE) %>%
ungroup()
# ──────────────────────────────────────────────────────────────
# Generate one plot per article using a loop
article_plots <- lapply(1:10, function(i) {
top10_features %>%
filter(doc_id == paste0("text", i)) %>%
slice_max(tf_idf, n = 5, with_ties = FALSE) %>%
ggplot(aes(x = reorder(word, tf_idf), y = tf_idf)) +
geom_col(fill = "steelblue") +
labs(title = paste("Article", i + 15), x = NULL, y = "TF-IDF") +
theme_classic() +
coord_flip()
})
# Arrange all 10 plots in one grid
grid.arrange(grobs = article_plots, ncol = 3)
