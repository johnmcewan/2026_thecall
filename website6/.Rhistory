#the csv that is result of entity freq. tool
Peopmnart <- read.csv("data-peopleinmondaynitearticles.csv", stringsAsFactors = FALSE)
# Quick inspection
cat("Entity Sheet columns:", colnames(entities), "\n\n")
cat("Articles Data columns:", colnames(articles_data), "\n\n")
# Quick inspection
cat("Entity Sheet columns:", colnames(manualentities), "\n\n")
cat("Articles Data columns:", colnames(Peopmnart), "\n\n")
cat("Number of entities:", nrow(manualentities), "\n")
cat("Number of article entries:", nrow(Peopmnart), "\n")
# ============================================================================
# PREPARE DATA FOR MATCHING
# ============================================================================
# Identify which column contains person names in each dataset
# Adjust these column names based on your actual data structure
# For entities sheet - look for a "Name" or "Person" column
entity_name_col <- colnames(manualentities)[grepl("name|person|entity", colnames(manualentities), ignore.case = TRUE)][1]
# For articles data - look for a "Name" or similar column
article_name_col <- colnames(Peopmnart)[grepl("name|person|entity", colnames(Peopmnart), ignore.case = TRUE)][1]
cat("Entity column being used:", entity_name_col, "\n")
cat("Article column being used:", article_name_col, "\n\n")
# Extract and clean names (remove leading/trailing whitespace, convert to lowercase for matching)
entity_names <- manualentities[[entity_name_col]] %>%
trimws() %>%
tolower()
article_names <- Peopmnart[[article_name_col]] %>%
trimws() %>%
tolower()
# Get unique names from articles to reduce computation
unique_article_names <- unique(article_names)
# ============================================================================
# FUZZY MATCHING FUNCTION
# ============================================================================
# Function to find matches above a similarity threshold
find_matches <- function(entity_name, article_names, threshold = 0.85) {
# Calculate Jaro-Winkler distance (values close to 1 are very similar)
similarities <- stringdist::stringsim(entity_name, article_names, method = "jw")
# Find matches above threshold
matches <- which(similarities >= threshold)
if (length(matches) > 0) {
return(data.frame(
original_entity = entity_name,
potential_match = article_names[matches],
similarity = similarities[matches],
stringsAsFactors = FALSE
))
} else {
return(NULL)
}
}
# ============================================================================
# RUN MATCHING
# ============================================================================
# Run matching for each entity
all_matches <- list()
for (i in seq_along(entity_names)) {
matches <- find_matches(entity_names[i], unique_article_names, threshold = 0.85)
if (!is.null(matches)) {
all_matches[[i]] <- matches
}
}
# Combine all matches into one dataframe
matches_df <- do.call(rbind, all_matches) %>%
arrange(desc(similarity))
# Remove exact matches with self (if same name appears in both)
matches_df <- matches_df %>%
filter(original_entity != potential_match)
# ============================================================================
# VIEW RESULTS
# ============================================================================
cat("\n========== POTENTIAL DUPLICATE ENTITIES ==========\n\n")
if (nrow(matches_df) > 0) {
print(matches_df)
cat("\n========== SUMMARY ==========\n")
cat("Total potential matches found:", nrow(matches_df), "\n")
cat("Unique entities with matches:", n_distinct(matches_df$original_entity), "\n\n")
# Group by original entity to see all matches for each
cat("===== MATCHES BY ENTITY =====\n\n")
matches_summary <- matches_df %>%
group_by(original_entity) %>%
summarise(
n_matches = n(),
best_match = potential_match[which.max(similarity)],
best_similarity = max(similarity),
all_matches = paste(potential_match, collapse = "; "),
.groups = 'drop'
)
print(matches_summary)
} else {
cat("No matches found above 0.85 similarity threshold.\n")
cat("Try lowering the threshold or checking your data structure.\n")
}
# ============================================================================
# EXPORT RESULTS
# ============================================================================
# Save matches to CSV for review
if (nrow(matches_df) > 0) {
write.csv(matches_df, "entity_matches_results.csv", row.names = FALSE)
write.csv(matches_summary, "entity_matches_summary.csv", row.names = FALSE)
cat("\nResults saved to:\n")
cat("  - entity_matches_results.csv (detailed matches)\n")
cat("  - entity_matches_summary.csv (summary by entity)\n")
}
