#Packages
# set up
library(readtext)
library(quanteda)
library(tidyverse)
library(gridExtra)
#Step 1: Import articles 16–25 (ten articles total) from the “Datasets” folder
#under the “Files” section on Canvas.
getwd()
article1 <- readtext("article16.txt")
article2 <-readtext("article17.txt")
article16 <- readtext("article16.txt")
article17 <-readtext("article17.txt")
article18 <-readtext("article18.txt")
article19 <-readtext("article19.txt")
article20 <-readtext("article20.txt")
article21 <-readtext("article21.txt")
article22 <-readtext("article22.txt")
article23 <-readtext("article23.txt")
article24 <-readtext("article24.txt")
article25 <-readtext("article25.txt")
# create a corpus using corpus() from quanteda
# this is to corpus that consist of mulitple document and you are computing.
#you use $ sign to choose a text.
Assi6_corpus <- corpus(c(article16$text, article17$text, article18$text,
article19$text, article20$text, article21$text,
article22$text, article23$text, article24$text,
article25$text))
# pre-processing
## tokenization - your are tokenizing all 10 documents. and removing punctuation
Assi6_token <- tokens(Assi6_corpus, remove_punct = TRUE,
remove_numbers = TRUE, remove_separators = TRUE,
remove_url = TRUE, remove_symbols = TRUE)
## lowercasing
Assi6_token <- tokens_tolower(Assi6_token)
#Removing stopwords
Assi6_token <- tokens_remove(Assi6_token, pattern = stopwords("en"))
custom_stopwords <- c("said", "also", "new", "york", "times", "mr", "ms")
Assi6_token <- tokens_remove(Assi6_token,
pattern = c(stopwords("en"), custom_stopwords))
head(stopwords("en"), 20)
length(stopwords("en"))  # how many stopwords total
topfeatures(dfm(Assi6_token), 20)
# create a document feature matrix (dfm)
assi6_dfm <- dfm(Assi6_token)
## compute tf-idf
assi6_tf_idf <- dfm_tfidf(assi6_dfm, scheme_tf = "count", # count means raw frequency
scheme_df = "inverse", # inverse means idf
base = 10, # base = 10 refers to the logarithm base in idf
force = FALSE) #if there is something going on do you want to cont. so you want flase meaning dont.
#you have a dfm so you cannot view it
#we need to convert it to a visual form
# view top 10 tf-idf words in the articles
topfeatures(nyt_tf_idf[16,],10) # article 16
# view top 10 tf-idf words in the articles
topfeatures(assi6_tf_idf[16,],10) # article 16
# view top 10 tf-idf words in the articles
topfeatures(assi6_tf_idf[1,], 10)  # article 16
topfeatures(assi6_tf_idf[2,], 10)  # article 17
topfeatures(assi6_tf_idf[3,], 10)  # article 18
topfeatures(assi6_tf_idf[4,], 10)  # article 19
topfeatures(assi6_tf_idf[5,], 10)  # article 20
topfeatures(assi6_tf_idf[6,], 10)  # article 21
topfeatures(assi6_tf_idf[7,], 10)  # article 22
topfeatures(assi6_tf_idf[8,], 10)  # article 23
topfeatures(assi6_tf_idf[9,], 10)  # article 24
topfeatures(assi6_tf_idf[10,], 10) # article 25
top10_features <- convert(assi6_tf_idf, to = "data.frame") %>%
pivot_longer(cols = -doc_id, names_to = "word", values_to = "tf_idf") %>%
filter(tf_idf > 0) %>%
group_by(doc_id) %>%
slice_max(tf_idf, n = 10, with_ties = FALSE) %>%
ungroup()
## visualize the features
# article 1
article1_top5 <-  top10_features %>% filter(doc_id=="text1") %>% slice_max(tf_idf, n=5) %>%
ggplot(aes(x=word, y=tf_idf)) + geom_col() + labs(title = "article1") +
