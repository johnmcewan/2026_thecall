# Load libraries
library(tidytext)
library(dplyr)
library(ggplot2)
library(tidyr)
library(SnowballC)
library(textstem)
library(quanteda)
library(quanteda.textplots)
# Read lines from CSV
newspaperlines <- readLines("newspaper_archive_summary.csv")
# --- ENTITY NAMES TO REMOVE FROM FREQUENCY ANALYSES ---
entity_names <- c("carl", "clark", "jim", "nunnelly", "emanuel", "cleaver",
"jerry", "price", "lloyd", "greenfield", "charles", "allen",
"harry", "sypert", "john", "martin", "jason", "joseph",
"don", "williams", "willie", "banks")
# --- UNIGRAMS ---
df_newspapli <- data.frame(text = newspaperlines) %>%
unnest_tokens(word, text) %>%
anti_join(stop_words) %>%        # removes common words like "the", "a", "is"
filter(!word %in% entity_names) %>%  # removes entity first/last names
count(word, sort = TRUE) %>%
slice_max(n, n = 15)
ggplot(df_newspapli, aes(x = reorder(word, n), y = n)) +
geom_col(fill = "black") +
coord_flip() +
labs(title = "Top 15 Unigrams",
x = "Word",
y = "Frequency") +
theme_minimal()
#Adding
# --- NORMALIZED FREQUENCY UNIGRAMS ---
df_normalized <- data.frame(text = newspaperlines) %>%
unnest_tokens(word, text) %>%
anti_join(stop_words) %>%
filter(!word %in% entity_names) %>%
count(word, sort = TRUE) %>%
mutate(normalized = n / sum(n)) %>%   # normalize by total word count
slice_max(normalized, n = 15, with_ties = FALSE)
ggplot(df_normalized, aes(x = reorder(word, normalized), y = normalized)) +
geom_col(fill = "purple") +
coord_flip() +
labs(title = "Top 15 Words - Normalized Frequency",
x = "Word",
y = "Relative Frequency (proportion)") +
scale_y_continuous(labels = scales::percent_format(accuracy = 0.1)) +
theme_minimal()
# --- BIGRAMS ---
bi_newspapli <- data.frame(text = newspaperlines) %>%
unnest_tokens(bigram, text, token = "ngrams", n = 2) %>%
separate(bigram, c("word1", "word2"), sep = " ") %>%
filter(!word1 %in% stop_words$word,
!word2 %in% stop_words$word,
!word1 %in% entity_names,        # removes entity names from bigrams
!word2 %in% entity_names) %>%
unite(bigram, word1, word2, sep = " ") %>%
count(bigram, sort = TRUE) %>%
slice_max(n, n = 15, with_ties = FALSE)
ggplot(bi_newspapli, aes(x = reorder(bigram, n), y = n)) +
geom_col(fill = "steelblue") +
coord_flip() +
labs(title = "Top 15 Bigrams", x = "Bigram", y = "Frequency") +
theme_minimal()
# --- TRIGRAMS ---
tri_newspapli <- data.frame(text = newspaperlines) %>%
unnest_tokens(trigram, text, token = "ngrams", n = 3) %>%
separate(trigram, c("word1", "word2", "word3"), sep = " ") %>%
filter(!word1 %in% stop_words$word,
!word2 %in% stop_words$word,
!word3 %in% stop_words$word,
!word1 %in% entity_names,        # removes entity names from trigrams
!word2 %in% entity_names,
!word3 %in% entity_names) %>%
unite(trigram, word1, word2, word3, sep = " ") %>%
count(trigram, sort = TRUE) %>%
slice_max(n, n = 15, with_ties = FALSE)
ggplot(tri_newspapli, aes(x = reorder(trigram, n), y = n)) +
geom_col(fill = "coral") +
coord_flip() +
labs(title = "Top 15 Trigrams", x = "Trigram", y = "Frequency") +
theme_minimal()
# --- STEMMED UNIGRAMS ---
df_newspaplistem <- data.frame(text = newspaperlines) %>%
unnest_tokens(word, text) %>%
anti_join(stop_words) %>%
filter(!word %in% entity_names) %>%     # removes entity names before stemming
mutate(word = wordStem(word)) %>%   # applies Porter stemming
count(word, sort = TRUE) %>%
slice_max(n, n = 15, with_ties = FALSE)
ggplot(df_newspaplistem, aes(x = reorder(word, n), y = n)) +
geom_col(fill = "darkred") +
coord_flip() +
labs(title = "Top 15 Stemmed Unigrams", x = "Stem", y = "Frequency") +
theme_minimal()
